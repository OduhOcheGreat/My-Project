rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection verification endpoint
    match /test/{testId} {
      allow read: if true;
    }

    // Collaborative leaf scan records shared in real-time between team members
    match /scans/{scanId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }
  }
}
